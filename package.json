{
  "name": "throughline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply throughline-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply throughline-db --remote",
    "db:seed:local": "wrangler d1 execute throughline-db --local --file=scripts/seed-dev.sql",
    "eval:tagging": "node --env-file=.dev.vars scripts/eval/run.ts",
    "eval:generate": "node --env-file=.dev.vars scripts/eval/generate-cases.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
