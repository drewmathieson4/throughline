{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": ["./worker-configuration.d.ts", "vite/client"],
    // Uint8Array.toBase64/fromBase64: in workerd and Node 26, but not yet in the ES2023 lib.
    "lib": ["ES2023", "ESNext.TypedArrays"],
    // Vite bundles the Worker, so resolve imports the way a bundler does (no .js suffixes).
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["worker"]
}
